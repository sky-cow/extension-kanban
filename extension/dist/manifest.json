{
  "manifest_version": 3,
  "name": "Collaborative Task Board",
  "description": "Kanban board UI for the collaborative task backend.",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Task Board"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "identity", "windows"],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://accounts.google.com/*",
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "387188006692-oro760rkstomtlh7l18panmrfgkpdomj.apps.googleusercontent.com",
    "scopes": ["openid", "email", "profile"]
  }
}
